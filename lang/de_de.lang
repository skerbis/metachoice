relation_select_clear_all = Auswahl leeren
relation_select_sort = Sortieren (ziehen)
relation_select_choose = Auswählen
relation_select_modal_title = Einträge auswählen
relation_select_cancel = Abbrechen
relation_select_apply = Übernehmen
relation_select_no_results = Keine Einträge
relation_select_empty_selection = Noch nichts ausgewählt
relation_select_error_loading = Fehler beim Laden der Daten
relation_select_online = Online
relation_select_offline = Offline

# Demo
relation_select_demo_inline = Inline-Modus
relation_select_demo_inline_intro = Das Widget erscheint direkt unter dem Feld. Quelle ist hier die Artikeltabelle mit Status-Punkt und ID.
relation_select_demo_modal = Modal-Modus
relation_select_demo_modal_intro = Ein Button mit Zähler öffnet das Widget als Overlay. „Übernehmen“ speichert, „Abbrechen“ verwirft die Änderungen.
relation_select_demo_single = Einzelauswahl
relation_select_demo_single_intro = Mit data-relation-multiple="0" (YForm: „Mehrfachauswahl“ aus) wird nur ein Datensatz gespeichert, eine neue Auswahl ersetzt die alte.
relation_select_demo_select = Select aufwerten (YForm be_manager_relation)
relation_select_demo_select_intro = Ein vorhandenes Select wird zum Widget – die Optionen kommen aus dem Select selbst, es gibt keinen API-Aufruf. So lassen sich be_manager_relation-Felder von YForm über die individuellen Attribute aufwerten.
relation_select_demo_value = Aktueller Wert
relation_select_demo_code = Code anzeigen

# YForm Value
relation_select_yform_description = Relation Select Widget – wählt Datensätze aus einer beliebigen Tabelle per Such-Widget aus
relation_select_yform_table = Tabelle
relation_select_yform_table_notice = Datenbankname der Quelltabelle, z.B. rex_my_table
relation_select_yform_value_field = Wertfeld
relation_select_yform_value_field_notice = Feld das als Wert gespeichert wird, standard: id
relation_select_yform_label_field = Anzeigefeld(er)
relation_select_yform_label_field_notice = Felder die als Label angezeigt werden, mehrere mit | trennen, z.B. vorname|nachname; lang:feld für mehrsprachige Felder
relation_select_yform_display_fields = Zusatzfelder (Display)
relation_select_yform_display_fields_notice = Optionale Zusatzfelder für Farbe/Badge, z.B. color:farbe|badge:status|(id) – trennen mit |
relation_select_yform_filter = WHERE-Filter
relation_select_yform_filter_notice = Bedingungen kommasepariert, z.B. status = 1, deleted = NULL, name ~ Meier*
relation_select_yform_order_by = Sortierung
relation_select_yform_order_by_notice = Felder & Richtung kommasepariert, z.B. name, ASC oder name, ASC, prio, DESC
relation_select_yform_multiple = Mehrfachauswahl
relation_select_yform_attributes_notice = Bitte als JSON schreiben, z.B. {"data-relation-mode":"modal"}. Enthält das JSON einen Key "data-relation-config", wird dessen Wert automatisch als Feldkonfiguration verwendet (Tabelle, Wertfeld usw.) – solange das Feld "Tabelle" oben leer ist.
relation_select_search_empty_option = Bitte wählen …
relation_select_list_records = Datensätze
