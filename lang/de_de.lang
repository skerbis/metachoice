relation_select_title = Relation Select
relation_select_settings = Einstellungen
relation_select_demo = Demo
relation_select_help = Hilfe
relation_select_install_success = Installation erfolgreich.
relation_select_install_token_msg = Der Token für Frontend-Aufrufe der API steht unter Relation Select → Einstellungen.

# Einstellungen
relation_select_settings_access_legend = Zugriff auf Tabellen
relation_select_settings_allowed_tables = Freigegebene Tabellen
relation_select_settings_allowed_tables_notice = Diese Tabellen dürfen alle Backend-Benutzer und der Frontend-Token lesen. Ohne Freigabe gilt: Admins dürfen alles, Backend-Benutzer die Inhaltstabellen des Cores (Artikel, Medien …) und YForm-Tabellen mit Tabellenrecht. Tabellen mit Zugangsdaten (rex_user, rex_config …) sind immer gesperrt und werden hier nicht angeboten.
relation_select_settings_max_rows = Maximale Zeilen pro Abfrage
relation_select_settings_max_rows_notice = 0 = unbegrenzt. Bereits ausgewählte Datensätze werden immer mitgeliefert.
relation_select_settings_yform_legend = YForm be_manager_relation
relation_select_settings_enhance = Relation-Felder aufwerten
relation_select_settings_enhance_notice = Ersetzt das Select von be_manager_relation-Feldern (Typ Select single/multiple) durch das Relation-Select-Widget – ohne API, ohne Tabellenfreigabe. Per Attribut: {"data-relation-select": "inline"} bzw. "modal" in den individuellen Attributen des Feldes; "off" schaltet ein Feld bei automatischer Aufwertung aus.
relation_select_settings_enhance_attribute = Nur mit Attribut data-relation-select
relation_select_settings_enhance_multiple = Automatisch für Mehrfachauswahl (select multiple)
relation_select_settings_enhance_all = Automatisch für alle Select-Relationen
relation_select_settings_enhance_off = Aus
relation_select_api_token = Frontend-Token
relation_select_token_description = Nur nötig, wenn die API vom Frontend aus aufgerufen wird (eigene JavaScript-Implementierung). Der Token darf ausschließlich die oben freigegebenen Tabellen lesen. Im Backend ist kein Token erforderlich, dort gelten die Benutzerrechte.
relation_select_token_none = Kein Token vorhanden – die API ist vom Frontend aus nicht erreichbar.
relation_select_copy_token = Token kopieren
relation_select_token_regenerate = Token neu erzeugen
relation_select_token_regenerate_confirm = Neuen Token erzeugen? Bestehende Frontend-Integrationen müssen angepasst werden.
relation_select_token_regenerated = Neuer Token erzeugt.
relation_select_token_remove = Token löschen (Frontend-API aus)
relation_select_token_remove_confirm = Token löschen? Die API ist danach vom Frontend aus nicht mehr erreichbar.
relation_select_token_removed = Token gelöscht.

