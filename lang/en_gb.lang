relation_select_install_success = Installation successful.
relation_select_install_token_msg = The token for frontend API calls is available under Relation Select → Settings.

# Settings
relation_select_settings_access_legend = Table access
relation_select_settings_allowed_tables = Allowed tables
relation_select_settings_allowed_tables_notice = All backend users and the frontend token may read these tables. Without an entry: admins may read everything, backend users the core content tables (articles, media …) and YForm tables they have table permissions for. Tables with credentials (rex_user, rex_config …) are always blocked and not offered here.
relation_select_settings_max_rows = Maximum rows per request
relation_select_settings_max_rows_notice = 0 = unlimited. Already selected records are always included.
relation_select_settings_yform_legend = YForm be_manager_relation
relation_select_settings_enhance = Enhance relation fields
relation_select_settings_enhance_notice = Replaces the select of be_manager_relation fields (type select single/multiple) with the Relation Select widget – no API, no table permission needed. Via attribute: {"data-relation-select": "inline"} or "modal" in the field's custom attributes; "off" excludes a field from automatic enhancement.
relation_select_settings_enhance_attribute = Only with attribute data-relation-select
relation_select_settings_enhance_multiple = Automatically for multiple selects
relation_select_settings_enhance_all = Automatically for all select relations
relation_select_settings_enhance_off = Off
relation_select_api_token = Frontend token
relation_select_token_description = Only required when the API is called from the frontend (custom JavaScript). The token may only read the tables allowed above. No token is needed in the backend, user permissions apply there.
relation_select_token_none = No token – the API cannot be reached from the frontend.
relation_select_copy_token = Copy token
relation_select_token_regenerate = Generate new token
relation_select_token_regenerate_confirm = Generate a new token? Existing frontend integrations must be updated.
relation_select_token_regenerated = New token generated.
relation_select_token_remove = Delete token (disable frontend API)
relation_select_token_remove_confirm = Delete the token? The API will no longer be reachable from the frontend.
relation_select_token_removed = Token deleted.

