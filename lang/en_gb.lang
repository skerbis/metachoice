# Demo
relation_select_demo_inline = Inline mode
relation_select_demo_inline_intro = The widget appears directly below the field. Source here is the article table with status dot and ID.
relation_select_demo_modal = Modal mode
relation_select_demo_modal_intro = A button with a counter opens the widget as an overlay. "Apply" saves, "Cancel" discards the changes.
relation_select_demo_single = Single selection
relation_select_demo_single_intro = With data-relation-multiple="0" (YForm: "Multiple" off) only one record is stored, a new pick replaces the old one.
relation_select_demo_select = Enhance a select (YForm be_manager_relation)
relation_select_demo_select_intro = An existing select becomes the widget – the options come from the select itself, no API call. This is how YForm be_manager_relation fields can be enhanced via their custom attributes.
relation_select_demo_value = Current value
relation_select_demo_code = Show code

# YForm Value
relation_select_yform_description = Relation Select widget – picks records from any table via a search widget
relation_select_yform_table = Table
relation_select_yform_table_notice = Database name of the source table, e.g. rex_my_table
relation_select_yform_value_field = Value field
relation_select_yform_value_field_notice = Field stored as value, default: id
relation_select_yform_label_field = Label field(s)
relation_select_yform_label_field_notice = Fields shown as label, separate multiple with |, e.g. firstname|lastname; lang:field for multilingual fields
relation_select_yform_display_fields = Display fields
relation_select_yform_display_fields_notice = Optional extra fields for colour/badge, e.g. color:colour|badge:status|(id) – separate with |
relation_select_yform_filter = WHERE filter
relation_select_yform_filter_notice = Conditions separated by comma, e.g. status = 1, deleted = NULL, name ~ Smith*
relation_select_yform_order_by = Order
relation_select_yform_order_by_notice = Fields & direction comma separated, e.g. name, ASC or name, ASC, prio, DESC
relation_select_yform_multiple = Multiple
relation_select_yform_attributes_notice = Write as JSON, e.g. {"data-relation-mode":"modal"}. If the JSON contains a key "data-relation-config", its value is used as field configuration (table, value field etc.) – as long as the field "Table" above is empty.
relation_select_search_empty_option = Please choose …
relation_select_list_records = records
